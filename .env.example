# ─────────────────────────────────────────────────────────────
# Frontend environment variables — copy to .env and fill values
# These are baked into the build at `docker compose build` time.
# ─────────────────────────────────────────────────────────────

# Full base URL of the API used by axios (e.g. https://api.yourdomain.com)
VITE_API_URL=https://api.yourdomain.com

# Base URL used in endpoint constants (e.g. https://api.yourdomain.com/api)
VITE_BASE_API_URL=https://api.yourdomain.com/api

# Docker deployment identity. Use unique values for each client hosted on the same server.
COMPOSE_PROJECT_NAME=camsme-inventory
FRONTEND_CONTAINER_NAME=camsme-inventory-frontend
FRONTEND_PORT=8081
